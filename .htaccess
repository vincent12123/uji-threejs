# Tipe MIME untuk berkas model (default server: text/plain)
AddType application/octet-stream .fbx .mpd
AddType model/gltf+json .gltf
AddType model/gltf-binary .glb

# Kompresi gzip untuk teks
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json
</IfModule>

# Model besar tidak dikompres otomatis oleh server, jadi sajikan salinan .gz yang
# dibuat saat deploy (lihat README) bila browser menerima gzip
RewriteEngine On
RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.+\.(fbx|gltf|mpd))$ $1.gz [L]

<FilesMatch "\.(fbx|mpd)\.gz$">
	ForceType application/octet-stream
	Header set Content-Encoding gzip
	Header append Vary Accept-Encoding
</FilesMatch>
<FilesMatch "\.gltf\.gz$">
	ForceType model/gltf+json
	Header set Content-Encoding gzip
	Header append Vary Accept-Encoding
</FilesMatch>

# Cache browser: model & tekstur jarang berubah, HTML selalu dicek ulang
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 1 hour"
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType application/octet-stream "access plus 30 days"
	ExpiresByType model/gltf+json "access plus 30 days"
	ExpiresByType model/gltf-binary "access plus 30 days"
	ExpiresByType image/jpeg "access plus 30 days"
	ExpiresByType image/png "access plus 30 days"
</IfModule>

# Berkas repo yang tidak perlu disajikan
<FilesMatch "^(README\.md|deploy\.sh)$">
	Require all denied
</FilesMatch>
